TARGET_LANG=en
# How many messages to read for a summary
SUMMARY_LIMIT=100

# Google AI Studio key (https://aistudio.google.com/apikey), used for Gemma 4
GEMINI_API_KEY=

ELEVENLABS_API_KEY=
