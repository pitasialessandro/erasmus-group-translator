# Telegram (https://my.telegram.org -> API development tools)
API_ID=
API_HASH=
# Phone of your Telegram account, international format (+39...)
PHONE=
# BotFather token
BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot)
